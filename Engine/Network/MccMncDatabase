    public class MccMncDatabase
    {
        private List<NetworkEntry> _allNetworks;

        public MccMncDatabase()
        {
            _allNetworks = LoadNetworks();
        }

        public void LoadFromFile(string path)
        {
            try
            {
                if (File.Exists(path))
                {
                    string json = File.ReadAllText(path);
                    var loaded = JsonConvert.DeserializeObject<List<NetworkEntry>>(json);
                    if (loaded != null && loaded.Count > 0)
                        _allNetworks = loaded;
                }
            }
            catch
            {
                // Fallback to built-in networks
            }
        }

        public List<string> GetCountries()
        {
            return _allNetworks.Select(n => n.Country).Distinct().OrderBy(c => c).ToList();
        }

        public List<NetworkEntry> GetNetworksByCountry(string country)
        {
            return _allNetworks.Where(n => n.Country == country).OrderBy(n => n.Operator).ToList();
        }

        public List<NetworkEntry> GetAllNetworks()
        {
            return _allNetworks;
        }

        private List<NetworkEntry> LoadNetworks()
        {
            // Try loading from JSON file first
            string jsonPath = Path.Combine(
                Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location),
                "Data", "mcc_mnc.json");

            if (File.Exists(jsonPath))
            {
                string json = File.ReadAllText(jsonPath);
                var loaded = JsonConvert.DeserializeObject<List<NetworkEntry>>(json);
                if (loaded != null && loaded.Count > 0)
                    return loaded;
            }

            // Fallback to built-in data
            return GetBuiltInNetworks();
        }

